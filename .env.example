# PostgreSQL connection used by the recon CLI (docker-compose.yml exposes this).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recon?sslmode=disable
# Schema that holds all recon tables (created if missing).
RECON_SCHEMA=recon
# Optional: enables the integration tests (they create and drop a throwaway schema).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/recon?sslmode=disable
